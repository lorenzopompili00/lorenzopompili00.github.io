# Ignore the contents of the _site directory
_site/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock
Gemfile.local.lock

# Ignore locally vendored gems and Jekyll/Bundler caches
vendor/
.bundle/
.jekyll-cache/
.jekyll-metadata

# Ingore files created by npm
node_modules
package-lock.json
# LaTeX build artifacts from the CV (files/main.tex); main.pdf is kept since the site links to it
files/*.aux
files/*.fdb_latexmk
files/*.fls
files/*.log
files/*.out
files/*.synctex.gz
files/*.toc
files/*.bbl
files/*.blg

# macOS
.DS_Store
